# Worker service — runs ONLY the background worker, NOT the API.
# This is deployed as a separate Cloud Run service from the API.
# The API sets RUN_WORKER=0 and does NOT start the worker in-process.
FROM python:3.11-slim as builder

WORKDIR /app
COPY requirements.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .
RUN pip install --no-cache /wheels/* \
    && python -m playwright install --with-deps chromium

COPY . .

ENV PYTHONPATH=/app
ENV PORT=8080
ENV APP_ENV=production
ENV STORAGE_BACKEND=sqlite
# Worker-only mode — the API does NOT start a worker when this is running
ENV WORKER_ONLY=1

EXPOSE 8080

# Start ONLY the worker process, not the API server
CMD ["python", "-m", "backend.worker"]
